{
  "name": "safetrackproglobal",
  "version": "2.0.0",
  "description": "AI-Powered Safety Management Platform for Healthcare, Oil & Gas, Construction, Manufacturing, and more.",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,md}'",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf build"
  },
  "keywords": [
    "safety",
    "management",
    "EHS",
    "compliance",
    "risk-assessment",
    "AI-safety",
    "industrial-safety",
    "healthcare-safety",
    "construction-safety",
    "oil-and-gas-safety",
    "react",
    "pwa",
    "progressive-web-app"
  ],
  "author": {
    "name": "Abigalistic Studios",
    "email": "info@safetrackproglobal.com",
    "url": "https://safetrackproglobal.com"
  },
  "license": "MIT",
  "homepage": "https://safetrackproglobal.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbigalisticStudios/safetrack-pro-global.git"
  },
  "bugs": {
    "url": "https://github.com/AbigalisticStudios/safetrack-pro-global/issues",
    "email": "info@safetrackproglobal.com"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
